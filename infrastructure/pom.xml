<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fiap.bank</groupId>
        <artifactId>fiap-bank-atm</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>infrastructure</artifactId>
    <packaging>jar</packaging>
    <name>fiap-bank-atm :: infrastructure</name>
    <description>
        Camada de Infraestrutura: implementação JDBC/SQLite do AccountRepository
        (acesso nativo, sem ORM) e o "composition root" da aplicação
        (AtmApplication.main), responsável por instanciar o repositório concreto,
        o AtmService e a AtmFrame e ligar as três pontas. É o único módulo que
        conhece todas as outras camadas ao mesmo tempo - o que é esperado do
        módulo mais externo/de infraestrutura numa arquitetura em camadas.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.fiap.bank</groupId>
            <artifactId>domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fiap.bank</groupId>
            <artifactId>application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fiap.bank</groupId>
            <artifactId>presentation</artifactId>
        </dependency>

        <!-- Driver SQLite JDBC (Anexo 7.1 do enunciado) -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.fiap.bank.atm.AtmApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
